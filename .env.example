# Application and mounted data
APP_PORT=8000
DATA_DIR=/app/data
DATA_FILE=/app/data/funding.json
SOURCES_FILE=/app/data/sources.json
STORE_MODE=file
MARKET_INTELLIGENCE_FILE=/app/data/market_intelligence.json

# Evidence engine: canonical evidence, normalized claims, audit runs, and metrics.
SEARCH_CRITERIA_FILE=/app/data/search_criteria.json
DIRECT_API_CRITERIA_FILE=/app/data/direct_api_criteria.json
TAVILY_EVIDENCE_RAW_FILE=/app/data/tavily_evidence_raw.json
DIRECT_API_RAW_FILE=/app/data/direct_api_raw.json
EVIDENCE_FILE=/app/data/evidence.json
CLAIMS_FILE=/app/data/claims.json
COLLECTION_RUNS_FILE=/app/data/collection_runs.json
CALCULATION_DEFINITIONS_FILE=/app/data/calculation_definitions.json
METRIC_SNAPSHOTS_FILE=/app/data/metric_snapshots.json
ONTOLOGY_TAXONOMY_FILE=/app/data/ontology_taxonomy.json
NORMALIZATION_VERSION=normalizer_v1
VALIDATION_MAX_FUNDING_AMOUNT_USD=100000000000
DIRECT_API_TIMEOUT_SECONDS=45

# Tavily web research. Set a real key before collection; never commit the key.
TAVILY_API_KEY=tvly-YOUR_API_KEY
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_RAW_FILE=/app/data/tavily_raw.json
TAVILY_CANDIDATES_FILE=/app/data/tavily_candidates.json
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIME_RANGE=month
TAVILY_INCLUDE_RAW_CONTENT=true

# GitHub direct API: structured builder-flow data. A fine-grained read-only token is recommended.
# Keep GITHUB_REQUIRE_TOKEN=true for scheduled production runs to avoid unauthenticated search limits.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=github_pat_YOUR_READ_ONLY_TOKEN
GITHUB_REQUIRE_TOKEN=true
GITHUB_USER_AGENT=IdeaCasino/1.0 contact@your-domain.example
GITHUB_MAX_RESULTS_PER_QUERY=20
GITHUB_INCLUDE_ACTIVITY_STATS=true
GITHUB_REQUEST_DELAY_SECONDS=0.15

# SEC EDGAR direct API: structured filing and XBRL evidence. No API key is required, but SEC requires an identifying User-Agent.
# CIK targets must be a JSON list: [{"cik":"0000320193","market_id":"mcp-security","company":"Example Company"}]
SEC_USER_AGENT=YOUR_COMPANY_NAME admin@your-domain.example
SEC_EDGAR_CIK_TARGETS=[]
SEC_LOOKBACK_DAYS=365
SEC_FETCH_COMPANY_FACTS=true
SEC_REQUEST_DELAY_SECONDS=0.12

# LLM interpretation is an optional, review-required extraction layer, not a data source.
# The default gpt-5-mini is a cost-efficient structured extraction model; use an OpenAI-compatible endpoint.
# LLM_ENABLED=false
# LLM_API_KEY=YOUR_LLM_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-mini

LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_free_api_key
LLM_ENRICHMENT_MODEL=openai/gpt-oss-20b
# LLM_MODEL=gpt-5-mini



LLM_MAX_COMPLETION_TOKENS=1400
LLM_SOURCE_CHAR_LIMIT=12000
LLM_MAX_EVIDENCE_PER_RUN=20

# LLM-orchestrated idea research. The default is local-first: read Neo4j/evidence first,
# then refresh Tavily/GitHub only when approved coverage is stale or insufficient.
IDEA_QUERY_POLICY_FILE=/app/data/idea_query_policy.json
IDEA_QUERY_LLM_MODEL=gpt-5-mini
# IDEA_QUERY_LLM_MODEL=openai/gpt-oss-20b
IDEA_QUERY_PLAN_MAX_TOKENS=900
IDEA_QUERY_SYNTHESIS_MAX_TOKENS=1800
IDEA_QUERY_EVIDENCE_LIMIT=20
IDEA_QUERY_GRAPH_LIMIT=30
IDEA_QUERY_USE_NEO4J=true

# Unified pipeline controls. CircleCI provides the scheduler; these values decide which collectors each run invokes.
PIPELINE_TAVILY_ENABLED=true
PIPELINE_GITHUB_ENABLED=true
PIPELINE_SEC_ENABLED=true
PIPELINE_LLM_ENABLED=false
PIPELINE_AUTO_VALIDATION=true
VALIDATION_MAX_CANDIDATES_PER_RUN=500
PIPELINE_AUTO_GRAPH_SYNC=true
PIPELINE_AUTO_METRIC_CALCULATION=true
PIPELINE_METRIC_WINDOW_DAYS=90
CIRCLECI_SCHEDULE_UTC=0 6 * * *

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-now

# Analysis window
LOOKBACK_DAYS=90

# Read-only Idea Casino MCP server. Run with: docker compose --profile mcp run --rm -T mcp
MCP_SERVER_ENABLED=true
MCP_SERVER_NAME=Idea Casino MCP
MCP_READ_ONLY=true
MCP_TRANSPORT=stdio
MCP_MAX_RESULTS=50
